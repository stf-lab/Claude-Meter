{
  "manifest_version": 3,
  "name": "Claude Meter",
  "description": "Shows your Claude.ai Pro usage percentage",
  "version": "1.3",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["*://claude.ai/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Meter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
